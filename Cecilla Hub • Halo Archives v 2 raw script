}

local activeTab = "Main"
local themeUpdateListeners = {}

local function registerThemeElement(callback)
    table.insert(themeUpdateListeners, callback)
    callback(currentTheme)

    local removed = false
    return function()
        if removed then return end
        removed = true

        for i = #themeUpdateListeners, 1, -1 do
            if themeUpdateListeners[i] == callback then
                table.remove(themeUpdateListeners, i)
                break
            end
        end
    end
end

local function applyTheme(themeName)
    if not Presets[themeName] then return end
    currentThemeName = themeName
    currentTheme = Presets[themeName]
    local listeners = table.clone(themeUpdateListeners)
    for _, cb in ipairs(listeners) do
        pcall(cb, currentTheme)
    end
end

