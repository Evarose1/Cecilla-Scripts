local function stopAutoFarm()
    farmRunId += 1
    autoFarmEnabled = false
    farmBusy = false

    if farmThread then
        task.cancel(farmThread)
        farmThread = nil
    end
end

local function startAutoFarm()
    if farmThread then
        return
    end

    farmRunId += 1
    local myRunId = farmRunId

    farmThread = task.spawn(function()
        while autoFarmEnabled and myRunId == farmRunId do
            local items = ItemsFolder:GetChildren()

            if #items > 0 then
                for _, item in ipairs(items) do
                    if not autoFarmEnabled or myRunId ~= farmRunId then
                        break
                    end

                    if isValidItem(item) and not farmBusy then
                        local targetCF = calculatePerfectStandCFrame(item)

                        if targetCF then
                            farmBusy = true

                            local ok = pcall(function()
                                safeTeleport(targetCF)
                                task.wait(0.15)

                                if autoFarmEnabled and myRunId == farmRunId and isValidItem(item) then
                                    interactWithItem(item)
                                end

                                task.wait(math.max(0.15, tonumber(Settings.FarmSpeed) or 0.35))
                            end)

                            farmBusy = false

                            if not ok then
                                task.wait(0.1)
                            end
                        end
                    end
                end
            else
                task.wait(0.5)
            end

            task.wait(0.1)
        end

        if farmRunId == myRunId then
            farmThread = nil
            farmBusy = false
        end
    end)
end

