local function switchTab(targetTab)
    activeTab = targetTab
    playSound(SOUND_TAB, 1.05)

    MainContent.Visible = (targetTab == "Main")
    SettingsContent.Visible = (targetTab == "Settings")
    CreditsContent.Visible = (targetTab == "Credits")

    for name, btn in pairs(tabButtons) do
        if name == targetTab then
            TweenService:Create(btn, TweenInfo.new(0.15), {
                BackgroundColor3 = currentTheme.CARD_BG,
                TextColor3 = currentTheme.ACCENT_CYAN
            }):Play()
            btn.Font = Enum.Font.GothamBold
        else
            TweenService:Create(btn, TweenInfo.new(0.15), {
                BackgroundColor3 = currentTheme.HEADER_BG,
                TextColor3 = currentTheme.TEXT_MUTED
            }):Play()
            btn.Font = Enum.Font.GothamMedium
        end
    end
end

MainTabBtn.MouseButton1Click:Connect(function() switchTab("Main") end)
SettingsTabBtn.MouseButton1Click:Connect(function() switchTab("Settings") end)
CreditsTabBtn.MouseButton1Click:Connect(function() switchTab("Credits") end)

for tabName, btn in pairs(tabButtons) do
    btn.MouseEnter:Connect(function()
        if activeTab ~= tabName then
            TweenService:Create(btn, TweenInfo.new(0.12), {
                BackgroundColor3 = currentTheme.CARD_HOVER,
                TextColor3 = currentTheme.TEXT_MAIN
            }):Play()
        end
    end)

    btn.MouseLeave:Connect(function()
        if activeTab ~= tabName then
            TweenService:Create(btn, TweenInfo.new(0.12), {
                BackgroundColor3 = currentTheme.HEADER_BG,
                TextColor3 = currentTheme.TEXT_MUTED
            }):Play()
        end
    end)
end

