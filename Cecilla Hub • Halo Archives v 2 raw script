local farmThread = nil
local farmRunId = 0
local farmBusy = false

local function isValidItem(item)
    return item
        and item.Parent
        and item:IsDescendantOf(ItemsFolder)
        and not item:IsA("Folder")
end

local function getCharacterParts()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    local hmr = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    return char, hmr, hum
end

local function calculatePerfectStandCFrame(item)
    if not isValidItem(item) then return nil end

    local position, size

    if item:IsA("Model") then
        local primary = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart", true)
        if primary then
            position = primary.CFrame
            size = primary.Size
        else
            position, size = item:GetBoundingBox()
        end
    elseif item:IsA("BasePart") then
        position = item.CFrame
        size = item.Size
    end

    if not position or not size then return nil end

    local _, _, hum = getCharacterParts()
    local hipHeight = 3.2

    if hum then
        if hum.RigType == Enum.HumanoidRigType.R15 then
            hipHeight = hum.HipHeight + 1.8
        else
            hipHeight = 3.2
        end
    end

    local topSurfaceY = size.Y / 2
    local targetPos = position.Position + Vector3.new(0, topSurfaceY + hipHeight, 0)

    return CFrame.new(targetPos)
end

local function safeTeleport(targetCFrame)
    local char, hmr, hum = getCharacterParts()
    if not hmr or not targetCFrame then return end

    spawnTeleportEffects(targetCFrame.Position)

    hmr.AssemblyLinearVelocity = Vector3.zero
    hmr.AssemblyAngularVelocity = Vector3.zero

    hmr.CFrame = targetCFrame

    task.wait(0.02)
    hmr.AssemblyLinearVelocity = Vector3.zero
    hmr.AssemblyAngularVelocity = Vector3.zero

    if hum then
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end
end

local function interactWithItem(item)
    if not isValidItem(item) then return end

    local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(prompt.HoldDuration > 0 and (prompt.HoldDuration + 0.05) or 0.1)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end
        return
    end

    local clickDetector = item:FindFirstChildWhichIsA("ClickDetector", true)
    if clickDetector and fireclickdetector then
        fireclickdetector(clickDetector)
        return
    end

    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.1)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

